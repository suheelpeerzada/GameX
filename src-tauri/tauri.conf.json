{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameX",
  "version": "1.0.1",
  "identifier": "com.gamex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GameX",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCNkEyNkExRkIzQTYxMjgKUldRb1lUcjdvU1pxVzVkSFhFTW5qV3c1WTRZdzJLbDFZS3NMK2RET1MydnFQeWd4eVhRejVucGwK",
      "endpoints": [
        "https://github.com/suheelpeerzada/GameX/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
